CURRENT_DIR=$(pwd)

echo "Stopping scenario..."

{% for c in scenario %}
docker compose \
{% for compose_file in c.compose_files %}               -f "{{ compose_file }}" \
{% endfor %}               --env-file "{{ c.env_file }}" \
               -p "{{ c.PROJECT_NAME }}" \
               down 2>/dev/null || true
{% endfor %}

{% for config_container in config_containers %}
docker rm -f "{{ config_container.name }}" 2>/dev/null || true
{% endfor %}

{% for network in networks %}
docker network rm "{{ network.name }}" 2>/dev/null || true
{% endfor %}

echo "Scenario stopped."
cd "$CURRENT_DIR" || exit 1
