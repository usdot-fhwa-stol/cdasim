CURRENT_DIR=$(pwd)

echo "Stopping scenario..."

{% for c in scenario %}
docker compose -p "{{ c.PROJECT_NAME }}" down 2>/dev/null || true
{% endfor %}

docker network rm sim_net 2>/dev/null || true

{% for c in scenario %}
{% if c.platform_net %}
docker network rm {{ c.platform_net }} 2>/dev/null || true
{% endif %}
{% if c.street_net %}
docker network rm {{ c.street_net }} 2>/dev/null || true
{% endif %}
{% endfor %}

rm -rf "{{ temp_dir }}" 2>/dev/null || true

echo "Scenario stopped."
cd "$CURRENT_DIR" || exit 1