CURRENT_DIR=$(pwd)

cleanup() {
    echo "Cleaning up..."
    bash "{{ temp_dir }}/sim_stop.sh" 2>/dev/null || true
    cd "$CURRENT_DIR" || exit 1
    exit 1
}
trap cleanup ERR

{% for network in networks %}
docker network create --driver {{ network.driver }}{% if network.subnet is defined %} --subnet {{ network.subnet }}{% endif %} {{ network.name }} 2>/dev/null || true
{% endfor %}

{% for config_container in config_containers %}
docker run --name "{{ config_container.name }}" --entrypoint sh "{{ config_container.image }}" -c '{{ config_container.init_command }}'
{% endfor %}

{% for c in scenario %}
docker compose \
{% for compose_file in c.compose_files %}               -f "{{ compose_file }}" \
{% endfor %}               --env-file "{{ c.env_file }}" \
               -p "{{ c.PROJECT_NAME }}" \
               up -d
{% endfor %}

echo "Scenario started."
cd "$CURRENT_DIR" || exit 1
