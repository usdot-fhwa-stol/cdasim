CURRENT_DIR=$(pwd)
PROJECT_NAMES=()

cleanup() {
    echo "Cleaning up..."
    for p in "${PROJECT_NAMES[@]}"; do
        [ -n "$p" ] && docker compose -p "$p" down
    done
    docker network rm sim_net 2>/dev/null || true
    rm -rf "{{ temp_dir }}" 2>/dev/null || true
    cd "$CURRENT_DIR" || exit 1
    exit 1
}
trap cleanup ERR

docker network create sim_net 2>/dev/null || true

{% for c in scenario %}
{% if c.platform_net %}
docker network create {{ c.platform_net }} 2>/dev/null || true
{% elif c.street_net %}
docker network create {{ c.street_net }} 2>/dev/null || true
{% endif %}

docker compose -f "{{ c.compose_file }}" \
               --env-file "{{ c.env_file }}" \
               -p "{{ c.PROJECT_NAME }}" \
               up -d && PROJECT_NAMES+=("{{ c.PROJECT_NAME }}")
{% endfor %}

echo "Scenario started."
cd "$CURRENT_DIR" || exit 1