{
  "architectures": ["ros1_ros2", "ros2"],
  "networks": {
    "simulation": {
      "name": "xil_sim_net",
      "subnet": "172.2.0.0/16",
      "fixed_octet": 2
    },
    "cloud": {
      "name": "xil_cloud_net",
      "subnet": "172.6.0.0/16",
      "fixed_octet": 6
    }
  },
  "allocation": {
    "private_octet_pool": {
      "start": 8,
      "end": 254
    },
    "simulation_host_pool": {
      "start": 20,
      "end": 254
    },
    "reserved_private_octets": [2, 3, 4, 5, 6, 7],
    "reserved_simulation_hosts": [2, 4, 5, 6, 7, 8, 9, 10, 11, 12, 47]
  },
  "shared_services": {
    "cdasim": {
      "interfaces": [
        {
          "network": "simulation",
          "env": "CDASIM_SIM_IP",
          "host": 2
        }
      ]
    },
    "carla-sensor-lib": {
      "interfaces": [
        {
          "network": "simulation",
          "env": "CARLA_SENSOR_SIM_IP",
          "host": 5
        }
      ]
    },
    "carma-cloud": {
      "interfaces": [
        {
          "network": "cloud",
          "env": "CARMA_CLOUD_PRIVATE_IP",
          "host": 47
        },
        {
          "network": "simulation",
          "env": "CARMA_CLOUD_SIM_IP",
          "host": 47
        }
      ]
    },
    "xml_rpc_server": {
      "architectures": ["ros2"],
      "interfaces": [
        {
          "network": "simulation",
          "env": "XML_RPC_SERVER_SIM_IP",
          "host": 12
        }
      ]
    }
  },
  "components": {
    "platform": {
      "network_name_template": "xil_carma_{index}_net",
      "subnet_template": "172.{octet}.0.0/16",
      "preferred_private_octets": {
        "1": 3,
        "2": 5
      },
      "architectures": {
        "ros1_ros2": {
          "private_endpoints": {
            "roscore": {
              "env": "ROSCORE_IP",
              "host": 2
            },
            "platform_ros1": {
              "env": "PLATFORM_ROS1_IP",
              "host": 3
            },
            "platform_ros2": {
              "env": "PLATFORM_ROS2_IP",
              "host": 4
            },
            "ros1_bridge": {
              "env": "ROS1_BRIDGE_IP",
              "host": 5
            },
            "carma-carla-integration": {
              "env": "CARLA_BRIDGE_ROS_IP",
              "host": 6
            },
            "ns3_adapter": {
              "env": "NS3_ADAPTER_ROS_IP",
              "host": 7
            }
          },
          "simulation_endpoints": {
            "carma-carla-integration": {
              "env": "CARLA_BRIDGE_SIM_IP",
              "preferred_instance_hosts": {
                "1": 6
              }
            },
            "ns3_adapter": {
              "env": "NS3_ADAPTER_SIM_IP",
              "preferred_instance_hosts": {
                "1": 7
              }
            }
          }
        },
        "ros2": {
          "private_endpoints": {
            "cdasim": {
              "env": "CDASIM_VEHICLE_IP",
              "host": 3
            },
            "platform_ros2": {
              "env": "PLATFORM_ROS2_IP",
              "host": 4
            },
            "carma-carla-integration": {
              "env": "CARLA_BRIDGE_ROS_IP",
              "host": 6
            },
            "v2x_ros_driver": {
              "env": "V2X_ROS_DRIVER_IP",
              "host": 7
            },
            "vehicle_registration_service": {
              "env": "VEHICLE_REGISTRATION_IP",
              "host": 14
            }
          },
          "simulation_endpoints": {
            "carma-carla-integration": {
              "env": "CARLA_BRIDGE_SIM_IP",
              "preferred_instance_hosts": {
                "1": 6
              }
            }
          }
        }
      }
    },
    "messenger": {
      "network_name_template": "xil_messenger_{index}_net",
      "subnet_template": "172.{octet}.0.0/16",
      "preferred_private_octets": {
        "1": 7
      },
      "architectures": {
        "ros1_ros2": {
          "private_endpoints": {
            "messenger_ros2": {
              "env": "MESSENGER_ROS2_IP",
              "host": 2
            },
            "messenger_roscore": {
              "env": "MESSENGER_ROSCORE_IP",
              "host": 3
            },
            "messenger_ros1_bridge": {
              "env": "MESSENGER_ROS1_BRIDGE_IP",
              "host": 4
            },
            "carma_messenger_bridge": {
              "env": "MESSENGER_BRIDGE_IP",
              "host": 5
            },
            "messenger_ns3_adapter": {
              "env": "MESSENGER_NS3_ADAPTER_IP",
              "host": 6
            }
          },
          "simulation_endpoints": {
            "carma_messenger_bridge": {
              "env": "MESSENGER_BRIDGE_SIM_IP",
              "preferred_instance_hosts": {
                "1": 9
              }
            },
            "messenger_ns3_adapter": {
              "env": "MESSENGER_NS3_ADAPTER_SIM_IP",
              "preferred_instance_hosts": {
                "1": 10
              }
            },
            "carma-messenger-vehicle-plugin": {
              "env": "MESSENGER_VEHICLE_PLUGIN_SIM_IP",
              "preferred_instance_hosts": {
                "1": 11
              }
            }
          }
        },
        "ros2": {
          "private_endpoints": {
            "messenger_ros2": {
              "env": "MESSENGER_ROS2_IP",
              "host": 2
            },
            "cdasim": {
              "env": "CDASIM_MESSENGER_IP",
              "host": 3
            },
            "carma_messenger_bridge": {
              "env": "MESSENGER_BRIDGE_IP",
              "host": 5
            },
            "messenger_v2x_ros_driver": {
              "env": "MESSENGER_V2X_ROS_DRIVER_IP",
              "host": 6
            },
            "messenger_vehicle_registration_service": {
              "env": "MESSENGER_VEHICLE_REGISTRATION_IP",
              "host": 16
            }
          },
          "simulation_endpoints": {
            "carma-messenger-vehicle-plugin": {
              "env": "MESSENGER_VEHICLE_PLUGIN_SIM_IP",
              "preferred_instance_hosts": {
                "1": 11
              }
            }
          }
        }
      }
    },
    "street": {
      "network_name_template": "xil_street_{index}_net",
      "subnet_template": "172.{octet}.0.0/16",
      "preferred_private_octets": {
        "1": 4
      },
      "private_endpoints": {
        "db": {
          "env": "V2XHUB_PRIVATE_IP",
          "host": 2,
          "shares_network_namespace_with": ["php", "v2xhub"]
        },
        "zookeeper": {
          "env": "STREET_INFRASTRUCTURE_IP",
          "host": 3,
          "shares_network_namespace_with": [
            "kafka",
            "kowl",
            "intersection_model",
            "tsc_service",
            "sensor_data_sharing_service"
          ]
        },
        "econolite-virtual-controller": {
          "env": "EVC_PRIVATE_IP",
          "host": 4,
          "conditional": "evc_enabled"
        }
      },
      "simulation_endpoints": {
        "db": {
          "env": "V2XHUB_SIM_IP",
          "preferred_instance_hosts": {
            "1": 8
          },
          "shares_network_namespace_with": ["php", "v2xhub"]
        },
        "econolite-virtual-controller": {
          "env": "EVC_SIM_IP",
          "preferred_instance_hosts": {
            "1": 4
          },
          "conditional": "evc_enabled"
        }
      }
    }
  }
}
