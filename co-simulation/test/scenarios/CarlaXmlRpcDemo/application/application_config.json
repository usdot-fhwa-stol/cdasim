{
  "simulation": {
    "duration": 60,
    "randomSeed": 12345,
    "timeStep": 100
  },
  "federates": {
    "carla": {
      "type": "carla",
      "configuration": {
        "carlaServerUrl": "http://localhost:8000",
        "connectionRetries": 5,
        "timeStep": 0.1,
        "mapName": "Town01",
        "enableActorManagement": true,
        "enableTrafficLightControl": true,
        "enableSensorManagement": true
      }
    },
    "sumo": {
      "type": "sumo",
      "configuration": {
        "sumoConfigFile": "sumo/sumo.sumocfg",
        "timeStep": 0.1
      }
    },
    "application": {
      "type": "application",
      "configuration": {
        "vehicleCount": 5,
        "trafficLightCount": 2,
        "sensorCount": 3
      }
    }
  },
  "mapping": {
    "vehicleMapping": "mapping/vehicle_mapping.json",
    "trafficLightMapping": "mapping/traffic_light_mapping.json",
    "sensorMapping": "mapping/sensor_mapping.json"
  }
}
